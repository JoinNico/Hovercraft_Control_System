% 文件：mythesis.sty
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mythesis}[2024/12/22 毕业设计论文样式]

% ============================================
% 1. 依赖包加载（优化您的现有包）
% ============================================
\RequirePackage{amsmath, amsthm, amssymb, bm}
\RequirePackage{graphicx}
\RequirePackage{booktabs, multirow, array, longtable}
\RequirePackage{geometry}
\RequirePackage{float}
\RequirePackage{enumerate}
\RequirePackage{listings}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{fancyhdr}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{hyperref}
\RequirePackage{txfonts}
\RequirePackage[table,xcdraw]{xcolor}
\RequirePackage{xpatch}
\RequirePackage[thicklines]{cancel}

% ============================================
% 2. 页面布局（优化您的设置）
% ============================================
% 更专业的页面设置（保持 oneside 单面打印）
\geometry{
    a4paper,
    top=3.0cm,      % 上边距
    bottom=2.5cm,   % 下边距
    left=3.0cm,     % 左边距
    right=2.5cm,    % 右边距
    headheight=1.5cm,
    headsep=0.5cm,
    footskip=1.2cm,
    includehead,
    includefoot
}

% 行距设置（1.25倍行距）
\linespread{1.25}
\setlength{\parskip}{0.5em}  % 段间距

% ============================================
% 3. 章节标题格式（适配 ctexart）
% ============================================
% 使用 ctexset 设置中文编号
\ctexset{
    % section 使用中文数字编号
    section = {
        name = {第,节},
        number = \chinese{section},
        format = \centering\Large\bfseries,
        aftername = \quad,
        beforeskip = 0pt,
        afterskip = 18pt
    },
    % subsection 使用中文数字编号
    subsection = {
        name = {},
        number = \chinese{subsection},
        format = \raggedright\large\bfseries,
        aftername = \quad,
        beforeskip = 12pt,
        afterskip = 6pt
    },
    % subsubsection 使用阿拉伯数字
    subsubsection = {
        format = \raggedright\normalsize\bfseries,
        number = \arabic{subsubsection},
        beforeskip = 12pt,
        afterskip = 6pt
    }
}

% 或者如果您想要更简洁的设置（推荐）：
% \ctexset{
%     section/name = {第,节},
%     section/number = \chinese{section},
%     section/format = \centering\Large\bfseries,
%     subsection/number = \chinese{subsection},
%     subsection/format = \raggedright\large\bfseries,
%     subsubsection/format = \raggedright\normalsize\bfseries
% }

% ============================================
% 4. 目录格式设置
% ============================================
% 设置目录深度
\setcounter{tocdepth}{3}  % 显示到subsubsection

% 使用 ctex 的目录格式（更兼容）
% 或者使用 titletoc，但要确保编号显示正确
\titlecontents{section}
    [0pt]
    {\bfseries\large}
    {\contentslabel[\chinese{section}、]{1.5em}}  % 中文编号加顿号
    {}
    {\titlerule*[0.5em]{$\cdot$}\contentspage}
    [\vspace{0.2em}]

\titlecontents{subsection}
    [1.5em]
    {\normalfont}
    {\contentslabel[\chinese{subsection}、]{2.0em}}  % 中文编号加顿号
    {}
    {\titlerule*[0.5em]{$\cdot$}\contentspage}
    [\vspace{0.1em}]

\titlecontents{subsubsection}
    [3.5em]
    {\small\normalfont}
    {\contentslabel[\arabic{subsubsection}.]{2.5em}}  % 阿拉伯数字加点
    {}
    {\titlerule*[0.5em]{$\cdot$}\contentspage}
    [\vspace{0.1em}]

% ============================================
% 5. 页眉页脚设置
% ============================================
\pagestyle{fancy}
\fancyhf{} % 清除所有页眉页脚

% 设置页眉
\fancyhead[C]{\normalsize 基于 RISC-V 微控制器的气垫船控制系统设计与实现}
\fancyfoot[C]{\thepage}

% 章节页样式（无页眉）
\fancypagestyle{plain}{
    \fancyhf{}
    \fancyfoot[C]{\thepage}
    \renewcommand{\headrulewidth}{0pt}
}

% ============================================
% 6. 图表格式设置
% ============================================
% 图表标题格式
\captionsetup{
    font=small,
    labelfont=bf,
    labelsep=quad,
    skip=6pt
}

% 图表编号格式：中文章节-序号
% 由于章节使用中文数字，编号格式也需要调整
\renewcommand{\thefigure}{\chinese{section}.\arabic{figure}}
\renewcommand{\thetable}{\chinese{section}.\arabic{table}}
\renewcommand{\theequation}{\chinese{section}.\arabic{equation}}

% 子图表支持
\captionsetup[subfigure]{
    font=footnotesize,
    labelfont=rm
}

% ============================================
% 7. 代码环境优化设置（稳健版本）
% ============================================
% 定义代码高亮颜色
\definecolor{codebg}{RGB}{248,248,248}
\definecolor{keywordcolor}{RGB}{0,0,255}
\definecolor{commentcolor}{RGB}{0,128,0}
\definecolor{stringcolor}{RGB}{163,21,21}

\lstset{
    backgroundcolor=\color{codebg},
    basicstyle=\ttfamily\small,
    keywordstyle=\color{keywordcolor}\bfseries,
    commentstyle=\color{commentcolor},
    stringstyle=\color{stringcolor},
    showstringspaces=false,
    numbers=left,
    numberstyle=\tiny\color{gray},
    stepnumber=1,
    numbersep=8pt,
    frame=single,
    rulecolor=\color{black!30},
    framesep=5pt,
    framerule=0.8pt,
    tabsize=4,
    captionpos=b,
    breaklines=true,
    breakatwhitespace=true,
    escapeinside={\%*}{*)},
    xleftmargin=15pt,
    xrightmargin=5pt,
    framexleftmargin=10pt,
    belowskip=10pt,
    aboveskip=10pt
}

% 代码标题设置
\captionsetup[lstlisting]{
    font=small,
    labelfont=bf,
    labelsep=space,
    justification=raggedright,
    singlelinecheck=false,
    skip=6pt
}

% ============================================
% 8. 自定义命令和工具
% ============================================

% 智能图片插入
\newcommand{\insertfigure}[4][htbp]{
    \begin{figure}[#1]
        \centering
        \includegraphics[width=#3\textwidth]{#2}
        \caption{#4}
        \label{fig:#2}
    \end{figure}
}

% 常用图片尺寸（带错误检查）
\newcommand{\smallfig}[2]{\insertfigure[h]{#1}{0.4}{#2}}
\newcommand{\medfig}[2]{\insertfigure[htbp]{#1}{0.6}{#2}}
\newcommand{\bigfig}[2]{\insertfigure[htbp]{#1}{0.8}{#2}}
\newcommand{\fullfig}[2]{\insertfigure[htbp]{#1}{0.95}{#2}}

% 表格工具
\newcommand{\topruleline}{\noalign{\ifnum0=`}\fi\hrule height 1.5pt\futurelet\reserved@a\@xhline}
\newcommand{\midruleline}{\noalign{\ifnum0=`}\fi\hrule height 0.8pt\futurelet\reserved@a\@xhline}
\newcommand{\bottomruleline}{\noalign{\ifnum0=`}\fi\hrule height 1.5pt\futurelet\reserved@a\@xhline}

% ============================================
% 10. 超链接设置
% ============================================
\hypersetup{
    colorlinks=true,
    linkcolor=blue,
    citecolor=green!50!black,
    urlcolor=blue!70!black,
    bookmarksnumbered=true,
    bookmarksopen=true,
    pdftitle={基于 RISC-V 微控制器的气垫船控制系统设计与实现},
    pdfauthor={顾云豪},
    pdfsubject={毕业设计论文},
    pdfkeywords={RISC-V, 气垫船, 控制系统, 微控制器}
}

% ============================================
% 11. 参考文献样式（保持简单）
% ============================================
% 如果使用 biblatex
\AtBeginDocument{
    \providecommand{\BIBdecl}{\relax}
    \providecommand{\BIBentry}{\relax}
}

% ============================================
% 12. 实用宏包和补丁
% ============================================
% 修复常见问题
\xpatchcmd{\@cite}{\hb@xt@\@tempdima}{\hbox}{}{}
\xpatchcmd{\@citex}{\hb@xt@\@tempdima}{\hbox}{}{}

\endinput